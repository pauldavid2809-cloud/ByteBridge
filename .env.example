# ============================================================
# Variables de entorno — copia este archivo como .env.local
# y rellena con los datos de tu proyecto de Supabase:
# Dashboard → Project Settings → API
# ============================================================

# URL del proyecto (ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (es segura de exponer: la tabla leads
# solo permite INSERT gracias a Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Telemetría de Prospección & Alertas en Vivo (Telegram / Webhook)
# ============================================================
# Token de tu bot creado en @BotFather (ej. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Tu ID numérico personal de Telegram obtenido en @userinfobot (ej. 987654321)
TELEGRAM_CHAT_ID=

# (Opcional) Webhook genérico para Discord, Slack o Make
LEAD_ALERT_WEBHOOK_URL=
